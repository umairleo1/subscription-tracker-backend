# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and update with your actual values
# ==============================================================================

# Project Information
PROJECT_NAME="Subscription Tracker API"
PROJECT_DESCRIPTION="Professional backend API for managing subscription tracking across multiple Google accounts"
PROJECT_VERSION="1.0.0"

# Server Configuration
HOST="127.0.0.1"
PORT=8000
ENVIRONMENT="development"  # development | staging | production
DEBUG=true

# Database Configuration
# PostgreSQL (Recommended for production)
DATABASE_URL="postgresql://username:password@localhost:5432/subscription_tracker"
# SQLite (For development only)
# DATABASE_URL="sqlite:///./subscription_tracker.db"

DATABASE_ECHO=false

# Database connection pool settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security Configuration - REQUIRED FOR PRODUCTION
SECRET_KEY="your-secret-key-must-be-at-least-32-characters-long"
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM="HS256"

# OAuth Token Encryption - REQUIRED FOR PRODUCTION
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_TOKEN_ENCRYPTION_KEY="your-encryption-key-must-be-at-least-32-chars"

# Google OAuth Configuration - REQUIRED
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001"

# Logging Configuration
LOG_LEVEL="INFO"  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_REQUESTS=true
LOG_RESPONSES=true
LOG_FILE=""  # Optional: path to log file

# Redis Configuration (Optional - for caching/sessions)
REDIS_URL="redis://localhost:6379/0"

# Email Configuration (Optional - for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_USE_TLS=true

# Celery Configuration (Optional - for background tasks)
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Error Monitoring & Alerting (Optional)
SENTRY_DSN=""  # Your Sentry DSN for error tracking
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_URL=""  # Slack/Teams webhook for alerts
PAGERDUTY_INTEGRATION_KEY=""  # PagerDuty integration

# Monitoring Configuration (Optional)
ENABLE_METRICS=true
METRICS_PORT=8001
DATADOG_API_KEY=""  # DataDog monitoring
DATADOG_APP_KEY=""

# ==============================================================================
# Security Notes:
# 1. Never commit .env files to version control
# 2. Use strong, unique values for SECRET_KEY and OAUTH_TOKEN_ENCRYPTION_KEY
# 3. Rotate secrets regularly in production
# 4. Use environment-specific configurations for staging/production
# ==============================================================================